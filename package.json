{
  "name": "tomioka-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp (Baileys) con stickers, packs y menu Tomioka. Compatible con Termux.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "tomioka-bot": "src/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node scripts/boot.js",
    "qr": "node scripts/boot.js --qr",
    "pair": "node scripts/boot.js --pair",
    "terminal": "node scripts/terminal.js",
    "doctor": "node src/doctor.js",
    "test": "node --test tests/*.test.js",
    "emojimix:sync": "node src/tools/sync-emojimix.js",
    "verify": "node scripts/verify-commands.js",
    "ai:test": "node scripts/test-ai.js",
    "search:test": "node scripts/test-search.js",
    "selftest": "node scripts/selftest.js",
    "web": "node scripts/serve-web.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "termux",
    "stickers"
  ],
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "node-webpmux": "^3.2.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.4"
  },
  "author": "Tomióka Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyanvalentinmail-prog/TomiOka.git"
  }
}
